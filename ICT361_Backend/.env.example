# Copy to .env and fill in your own values. NEVER commit or submit .env (it holds secrets).
PORT=5000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=ict361_registration
# Long random string, e.g. from: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Seed lecturer (node src/seedLecturer.js) - password at least 12 characters
SEED_LECTURER_USERNAME=lecturer1
SEED_LECTURER_PASSWORD=choose_a_strong_password
# Faculty code for the lecturer registration screen (leave empty to switch registration off)
LECTURER_REGISTRATION_CODE=

# Hosted (HTTPS) deployment only
TRUST_PROXY=false
REQUIRE_HTTPS=false
