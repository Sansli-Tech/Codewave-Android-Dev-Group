<?xml version="1.0" encoding="utf-8"?>
<!-- Student Groups tab: every lab group with live occupancy; tap one with space to request it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/campus_ground"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/student_groups_title"
                android:textColor="@color/campus_text"
                android:textSize="24sp"
                android:textStyle="bold"
                android:accessibilityHeading="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/student_groups_subtitle"
                android:textColor="@color/campus_muted"
                android:textSize="13sp" />

            <!-- My group / pending request -->
            <TextView
                android:id="@+id/tvStudentGroupsMine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_campus_card"
                android:padding="12dp"
                android:textColor="@color/campus_text"
                android:textSize="14sp"
                android:accessibilityLiveRegion="polite"
                tools:text="Your group: G08 · Request for G05 is Pending" />

            <!-- Online / offline / loading -->
            <TextView
                android:id="@+id/tvStudentGroupsStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/campus_muted"
                android:textSize="12sp"
                android:accessibilityLiveRegion="polite"
                tools:text="Live from the server" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressStudentGroups"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/listStudentGroups"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_campus_card"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStudentGroupsRetry"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:text="@string/student_groups_retry"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavStudent"
        style="@style/Widget.MUSync.BottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/menu_nav_student" />
</LinearLayout>
