<?xml version="1.0" encoding="utf-8"?>
<!-- One notification / request row. The buttons show only for requests waiting for a decision. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/groupInboxText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:orientation="horizontal">

        <View
            android:id="@+id/dotInboxUnread"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginTop="7dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_unread_dot"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvInboxTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/campus_text"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Group request: G05" />

            <TextView
                android:id="@+id/tvInboxBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/campus_text"
                android:textSize="14sp"
                tools:text="Test Student (90000001) asked to move from G08 to G05 (12/15)." />

            <TextView
                android:id="@+id/tvInboxMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/campus_muted"
                android:textSize="12sp"
                tools:text="5 minutes ago" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowInboxActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInboxNegative"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            tools:text="Reject" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInboxPositive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minHeight="48dp"
            tools:text="Approve" />
    </LinearLayout>
</LinearLayout>
