<?xml version="1.0" encoding="utf-8"?>
<!-- Student Notifications tab: announcements and answers to the student's requests. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/campus_ground"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/nav_notifications"
                android:textColor="@color/campus_text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/notifications_subtitle"
                android:textColor="@color/campus_muted"
                android:textSize="13sp" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressStudentNotifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvStudentNotificationsStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/bg_campus_chip_warn"
                android:padding="12dp"
                android:text="@string/inbox_offline"
                android:textColor="@color/campus_warn_text"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/listStudentNotifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_campus_card"
                android:divider="?android:attr/listDivider"
                android:orientation="vertical"
                android:showDividers="middle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStudentNotificationsRetry"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:text="@string/student_groups_retry"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavStudent"
        style="@style/Widget.MUSync.BottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/menu_nav_student" />
</LinearLayout>
