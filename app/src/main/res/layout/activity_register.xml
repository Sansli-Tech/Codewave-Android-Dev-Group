<?xml version="1.0" encoding="utf-8"?>
<!-- Campus photo across the top, fading into the page colour, with the start screen's circuit lines on top. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_gravity="top"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_campus_building"
        android:importantForAccessibility="no" />

    <View
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_auth_photo_overlay" />

    <!-- Same circuit/network lines as the start screen, only below the photo
         (the fields have their own solid background, so the lines never show inside them). -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="300dp"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_campus_pattern"
        android:importantForAccessibility="no" />

    <ScrollView
        android:id="@+id/scrollViewRegister"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:fitsSystemWindows="true">
    
        <!-- Centres the form on tall screens (moves it down from the top); scrolls when it doesn't fit. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical">
    
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">
    
            <!-- App logo (floats gently; still if the phone's animations are off) -->
            <ImageView
                android:id="@+id/imgRegisterLogo"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:padding="20dp"
                android:background="@drawable/bg_logo_shadow"
                android:contentDescription="@string/app_logo_description"
                android:src="@mipmap/ic_launcher_round"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
    
            <TextView
                android:id="@+id/tvRegisterTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/title_register"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                android:textStyle="bold"
                android:contentDescription="@string/title_register"
                app:layout_constraintTop_toBottomOf="@id/imgRegisterLogo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
    
            <TextView
                android:id="@+id/tvRegisterSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/desc_register_subtitle"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                app:layout_constraintTop_toBottomOf="@id/tvRegisterTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
    
            <!-- Offline Draft Alert Banner -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOfflineDraftBanner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                tools:visibility="visible"
                app:cardBackgroundColor="?attr/colorTertiaryContainer"
                app:cardCornerRadius="8dp"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toBottomOf="@id/tvRegisterSubtitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
    
                <TextView
                    android:id="@+id/tvOfflineBannerText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="@string/status_offline_draft"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnTertiaryContainer"
                    android:drawableStart="@android:drawable/stat_sys_warning"
                    android:drawablePadding="8dp" />
            </com.google.android.material.card.MaterialCardView>
    
            <!-- Student Number (also becomes the sign-in username) -->
            <com.google.android.material.textfield.TextInputLayout

                app:boxBackgroundColor="@color/campus_card"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusBottomEnd="16dp"
                android:id="@+id/tilStudentNumber"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/label_student_number"
                app:counterEnabled="true"
                app:counterMaxLength="9"
                app:errorEnabled="true"
                app:layout_constraintTop_toBottomOf="@id/cardOfflineDraftBanner"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
    
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etStudentNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:inputType="number"
                    android:maxLength="9"
                    android:digits="0123456789"
                    android:contentDescription="@string/label_student_number" />
            </com.google.android.material.textfield.TextInputLayout>
    
            <!-- Claim Code from the lecturer (16 characters, valid 15 minutes) -->
            <com.google.android.material.textfield.TextInputLayout

                app:boxBackgroundColor="@color/campus_card"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusBottomEnd="16dp"
                android:id="@+id/tilClaimCode"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/label_claim_code"
                app:helperText="@string/helper_claim_code"
                app:counterEnabled="true"
                app:counterMaxLength="16"
                app:errorEnabled="true"
                app:layout_constraintTop_toBottomOf="@id/tilStudentNumber"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
    
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etClaimCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:maxLength="16"
                    android:inputType="textCapCharacters|textNoSuggestions"
                    android:fontFamily="monospace"
                    android:contentDescription="@string/label_claim_code" />
            </com.google.android.material.textfield.TextInputLayout>
    
            <!-- New Password -->
            <com.google.android.material.textfield.TextInputLayout

                app:boxBackgroundColor="@color/campus_card"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusBottomEnd="16dp"
                android:id="@+id/tilPassword"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/label_new_password"
                app:helperText="@string/helper_password"
                app:endIconMode="password_toggle"
                app:errorEnabled="true"
                app:layout_constraintTop_toBottomOf="@id/tilClaimCode"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
    
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:inputType="textPassword"
                    android:contentDescription="@string/label_new_password" />
            </com.google.android.material.textfield.TextInputLayout>
    
            <!-- Confirm Password -->
            <com.google.android.material.textfield.TextInputLayout

                app:boxBackgroundColor="@color/campus_card"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusBottomEnd="16dp"
                android:id="@+id/tilConfirmPassword"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/label_confirm_password"
                app:endIconMode="password_toggle"
                app:errorEnabled="true"
                app:layout_constraintTop_toBottomOf="@id/tilPassword"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
    
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:inputType="textPassword"
                    android:contentDescription="@string/label_confirm_password" />
            </com.google.android.material.textfield.TextInputLayout>
    
            <!-- Primary Register Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegister"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minHeight="48dp"
                android:text="@string/btn_register"
                app:layout_constraintTop_toBottomOf="@id/tilConfirmPassword"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
    
            <!-- Link to Sign In -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoToSignIn"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:contentDescription="@string/link_to_login"
                android:minHeight="18dp"
                android:text="@string/link_to_login"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.491"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnRegister"
                app:layout_constraintVertical_bias="0.04" />
    
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegisterAsLecturer"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginTop="56dp"
                android:text="@string/switch_to_lecturer_reg"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnRegister" />

            <!-- Not on the lecturer's list yet (no claim code): ask to join -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAskToJoin"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/link_ask_to_join"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnRegisterAsLecturer" />
    
        </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
