<?xml version="1.0" encoding="utf-8"?>
<!-- A white card with a bold title and body text (Guide and Help tabs). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:background="@drawable/bg_campus_card"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvInfoTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/campus_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvInfoBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingMultiplier="1.2"
        android:textColor="@color/campus_muted"
        android:textSize="14sp" />
</LinearLayout>
