    <string name="guide_title">Guide</string>
    <string name="guide_students_title">For students</string>
    <string name="guide_students_body">1. Ask your lecturer for a claim code. It works once and lasts 15 minutes.\n\n2. Tap Register and enter your 9-digit student number, the code and a password of at least 12 characters.\n\n3. Sign in with your student number and password to see your record and lab group.</string>
    <string name="guide_lecturers_title">For lecturers</string>
    <string name="guide_lecturers_body">Sign in with your staff account. From the Roster tab, tap ⋮ next to a student and choose Generate claim code, then give the code to the student.\n\nLab groups hold up to their set capacity. The server always has the final say, so a full group is refused even if two people save at the same moment.</string>

    <string name="help_title">Help</string>
    <string name="help_code_title">My claim code doesn\'t work</string>
    <string name="help_code_body">Codes expire after 15 minutes and work only once. Ask your lecturer to generate a new one.</string>
    <string name="help_offline_title">I\'m offline</string>
    <string name="help_offline_body">You can still see the data already on your phone. Pull the latest changes from the Sync tab once you\'re back online.</string>
    <string name="help_account_title">I forgot my password</string>
    <string name="help_account_body">Tap "Forgot password?" on the sign-in screen. A code is e-mailed to your recovery e-mail (lecturers: your staff e-mail). No e-mail added yet? Ask your lecturer for a reset code.</string>

    <string name="account_title">Account</string>
    <string name="account_body">Sign in if you already have an account, or register with the claim code from your lecturer.</string>

