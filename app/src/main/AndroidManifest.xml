<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to reach the backend. Without it every network call fails. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+: asked once on Home; without it the in-app badges still work. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".MUSyncApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MUStudentSync">

        <!-- Launcher screen: opens when the app icon is tapped -->
        <!-- Launcher screen: opens when the app icon is tapped -->
        <!-- Launcher screen: the landing page (signed-in users are sent straight to their home) -->
        <activity
            android:name=".LandingActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".SignInActivity" android:exported="false" />

        <!-- Lecturer tabs (bottom navigation) -->
        <activity android:name=".LecturerHomeActivity" android:exported="false" />
        <activity android:name=".GroupsActivity" android:exported="false" />
        <activity android:name=".SyncActivity" android:exported="false" />
        <activity android:name=".LecturerProfileActivity" android:exported="false" />

        <!-- Opened only via Intent from other screens, so no intent-filter -->
        <activity android:name=".RegisterActivity" android:exported="false" />
        <activity android:name=".StudentProfileActivity" android:exported="false" />
        <activity android:name=".LecturerRosterActivity" android:exported="false" />
        <activity android:name=".StudentEditorActivity" android:exported="false" />
        <activity android:name=".RegisterLecturerActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ForgotPasswordActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".StudentHomeActivity" android:exported="false" />
        <activity android:name=".StudentGroupsActivity" android:exported="false" />
        <activity android:name=".SettingsActivity" android:exported="false" />
        <activity android:name=".LecturerInboxActivity" android:exported="false" />
        <activity android:name=".StudentNotificationsActivity" android:exported="false" />

        <!-- Push notifications (Firebase). Generic, private alerts only. -->
        <service
            android:name=".push.MUMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="mu_updates" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />

        <!-- Shares the exported Excel file with other apps through a temporary content:// link. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
